# Root-level env reference — copy to backend/.env and frontend/.env.local as needed.
# See backend/app/config.py and frontend/src/lib/api.ts for how these are consumed.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://floatchat:floatchat@localhost:5432/floatchat
# Redis is optional (query-result cache only) — leave unset for local dev.
REDIS_URL=
# Free-tier key from https://aistudio.google.com ("Get API key") — never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
# Point this at your deployed backend's URL in production (e.g. on Vercel).
NEXT_PUBLIC_API_URL=http://localhost:8000

# "development" (the default) exposes /docs, /redoc, /openapi.json and skips the HSTS header —
# both fine on localhost, both undesirable once actually deployed. Set to "production" there.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://floatchat:floatchat@localhost:5432/floatchat
# Redis is optional per spec (query-result cache only) and skipped for local dev — no native
# Windows build; leave unset unless you set one up via WSL/Docker/Memurai.
REDIS_URL=
# Free-tier key from https://aistudio.google.com ("Get API key") — never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=["http://localhost:3000"]
# Caps real Gemini calls per UTC day — a safety valve, not a billing plan (app/llm/spend_tracker.py).
GEMINI_DAILY_CALL_LIMIT=300
# Requests/minute per client IP before a 429 (app/middleware/security.py).
RATE_LIMIT_PER_MINUTE=120
# Gates /admin/* (app/api/admin.py). Leave unset to disable the admin API entirely — there is no
# default value, so an unset key means every /admin/* call gets a 503, never silent access.
ADMIN_API_KEY=
